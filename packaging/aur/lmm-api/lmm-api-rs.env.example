# Rust is an optional migration-preview backend and does not yet own every Go
# production route. Copy only the settings you need into lmm-api.env.
DATABASE_URL=postgres://lmm_api:REPLACE_ME@127.0.0.1/lmm_api?options=-csearch_path%3Dlmm_prod_v1
VALKEY_URL=redis://:REPLACE_ME@127.0.0.1:6379/0
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CRYPTO_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
LMM_SCHEMA_CONTRACT=1
LMM_RS_LISTEN_ADDR=127.0.0.1:3000
LMM_RS_SLOT=blue
LMM_DEPENDENCY_TIMEOUT_SECONDS=2
LMM_DRAIN_TIMEOUT_SECONDS=30
LMM_PUBLIC_CONTENT_CACHE_TTL_SECONDS=5
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=360
GLOBAL_API_RATE_LIMIT_DURATION=180
TRUSTED_PROXIES=127.0.0.1
